;; Configuration for built-in Mac Keyboard - ANSI Layout (Angle Mod)
;; Shared blocks come from shared/*.kbd. kanata resolves (include ...) against
;; the directory of the --cfg path (~/.config/kanata), so shared/ lives there.
(include shared/mac-defcfg.kbd)
(include shared/mac-chords.kbd)
(include shared/ansi-defsrc.kbd)

(platform (macos)
  (deflayer base
    _     🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
    _     _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     @a    @s    @d    @f    @g    _     @j    @k    @l    @;    _     _     _
    z     x     c     v     b     _     _     _     _     _     _     _
    @fn   _     _     _                 @spc              _     _     _     _     _     _
  )
)

(platform (macos)
  (deflayer fn
    _     f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
    _     _     _     _     _     _     _     _     _     _     _     _     _     del
    _     f12   f7    f8    f9    @scr  _     @redo @paste @copy @cut  @undo _
    _     f11   f4    f5    f6    caps  _     lctl  lsft  lalt  lmet  del   _     _
    _     f10   f1    f2    f3    @scrm _     _     _     _     _     _
    _     _     _     _                 _                 _     _     ⤒    ⇞ ⇟    ⤓
  )
)

(include shared/ansi-num-sym-arrows.kbd)
(include shared/vars.kbd)
(include shared/angle-aliases.kbd)
(include shared/ansi-media-mouse.kbd)
