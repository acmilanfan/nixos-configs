;; Configuration for built-in Mac Keyboard - ISO Layout (Angle Mod)
;; Shared blocks come from shared/*.kbd. kanata resolves (include ...) against
;; the directory of the --cfg path (~/.config/kanata), so shared/ lives there.
(include shared/mac-defcfg.kbd)
(include shared/mac-chords.kbd)

(platform (macos)
  (defsrc
    esc    f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
    nubs   1     2     3     4     5     6     7     8     9     0     -     =     bspc
    tab    q     w     e     r     t     y     u     i     o     p     [     ]
    caps   a     s     d     f     g     h     j     k     l     ;     '     \     ret
    lsft   grv   z     x     c     v     b     n     m     ,     .     /     rsft
    fn     lctl  lalt  lmet              spc               rmet  ralt  ◀    ▲ ▼    ▶
  )
)

(platform (macos)
  (deflayer base
    _     🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
    grv   _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     @a    @s    @d    @f    @g    _     @j    @k    @l    @;    _     _     _
    _     z     x     c     v     b     _     _     _     _     _     _     _
    @fn   _     _     _                 @spc              _     _     _     _     _     _
  )
)

(platform (macos)
  (deflayer fn
    _     f1    f2    f3    f4    f5    f6    f7    f8    f9    f10   f11   f12
    _     _     _     _     _     _     _     _     _     _     _     _     _     del
    _     f12   f7    f8    f9    @scr  _     @redo @paste @copy @cut  @undo _
    _     f11   f4    f5    f6    caps  _     lctl  lsft  lalt  lmet  del   _     _
    _     _     f10   f1    f2    f3    @scrm _     _     _     _     _     _
    _     _     _     _                 _                 _     _     ⤒    ⇞ ⇟    ⤓
  )
)

(platform (macos)
  (deflayer numbers
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _     _
    _     [     7     8     9     ]     _     _     _     _     _     _     _
    _     '     4     5     6     =     _     lctl  lsft  lalt  lmet  _     _     _
    _     _     `     1     2     3     \     _     _     _     _     _     _
    _     _     _     _                 0                 _     _     _     _     _     _
  )
)

(platform (macos)
  (deflayer symbols
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _     _
    _     S-[   S-7   S-8   S-9   S-]   _     _     _     _     _     _     _
    _     S-'   S-4   S-5   S-6   S-=   _     lctl  lsft  lalt  lmet  _     _     _
    _     _     S-`   S-1   S-2   S-3   S-\   _     _     _     _     _     _
    _     _     _     _                 S-0               _     _     _     _     _     _
  )
)

(platform (macos)
  (deflayer arrows
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     @redo @paste @copy @cut  @undo  _     _
    _     lmet  lalt  lsft  lctl  _     left  down  up    rght  bspc  _     _     _
    _     _     _     _     _     _     ins   pgdn  pgup  home  end   _     _
    _     _     _     _                 ret               _     _     _     _     _     _
  )
)

(include shared/vars.kbd)
(include shared/angle-aliases.kbd)

(platform (macos)
  (deflayer media
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     brdn  brup  _     _     _     _
    _     lmet  lalt  lsft  lctl  _     prev  vold  volu  next  mute  _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _                 pp                _     _     _     _     _     _
  )
)

;; Mouse layer: g (held) → mouse control
;; Right hand: hjkl = move, nm,. = scroll, ; = right click
;; Left hand home row: direct mods for shift/ctrl+click
;; Space = left click
(platform (macos)
  (deflayer mouse
    _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _     _     _     _     _
    _     _     _     _     _     _     @redo @paste @copy @cut  @undo _     _
    _     lmet  lalt  lsft  lctl  _     @mlf  @mdn  @mup  @mrt  mrgt  _     _     _
    _     _     _     _     _     _     _     @whl  @whu  @whd  @whr  mmid  _
    _     _     _     _                 mlft              _     _     _     _     _     _
  )
)
