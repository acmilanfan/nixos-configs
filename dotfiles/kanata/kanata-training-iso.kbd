;; Training Mode - Forces proper home row mod usage (ISO)
;; Disabled: lsft, rsft, lctl, lalt, lmet, rmet, ralt (physical mods outside home row)
;; Disabled: esc, ret, bspc, caps (use chords/layers instead)
;; Alternatives: esc=(w e) or (a ;), ret=v+spc, bspc=v+;, caps=(d k)
;; Shared blocks come from shared/*.kbd. kanata resolves (include ...) against
;; the directory of the --cfg path (~/.config/kanata), so shared/ lives there.
(include shared/mac-defcfg.kbd)
(include shared/mac-chords.kbd)
(include shared/iso-defsrc.kbd)

(platform (macos)
  (deflayer base
    XX    🔅    🔆    mctl  sls   dtn   dnd   ◀◀    ▶⏸    ▶▶    🔇    🔉    🔊
    XX    _     _     _     _     _     _     _     _     _     _     _     _     XX
    _     _     _     _     _     _     _     _     _     _     _     _     _
    XX    @a    @s    @d    @f    @g    _     @j    @k    @l    @;    _     _     XX
    XX    grv   _     _     _     @v    @b    @n    @m    _     _     _     XX
    @fn   XX    XX    XX                @spc              XX    XX    XX    _     _     _     _
  )
)

(include shared/iso-fn-num-sym-arrows.kbd)
(include shared/vars.kbd)
(include shared/homerow-aliases.kbd)
(include shared/iso-media.kbd)

;; Mouse layer: g (held) → mouse control
;; Right hand: hjkl = move, nm,. = scroll, ; = right click
;; Left hand home row: direct mods for shift/ctrl+click
;; Space = left click
(platform (macos)
  (deflayer mouse
    XX    _     _     _     _     _     _     _     _     _     _     _     _
    XX    _     _     _     _     _     _     _     _     _     _     _     _     XX
    _     _     _     _     _     _     @redo @paste @copy @cut  @undo _     _
    _     lmet  lalt  lsft  lctl  _     @mlf  @mdn  @mup  @mrt  mrgt  _     _     _
    XX    grv   _     _     _     _     _     @whl  @whu  @whd  @whr  mmid  XX
    @fn   XX    XX    XX                mlft              XX    XX    XX    _     _     _     _
  )
)
