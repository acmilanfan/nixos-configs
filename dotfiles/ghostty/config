# Font
font-family = "RobotoMono Nerd Font"
font-style = "Medium"
font-style-bold = "Bold"
font-style-italic = "Medium Italic"
font-style-bold-italic = "Bold Italic"
font-size = 16
font-thicken = true

# Window decorations & Titlebar (hides title, proxy icon, and buttons)
macos-titlebar-style = hidden

# Window padding (matches Alacritty flush layout)
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false

# Every new window starts on the frame where nanowm (Hammerspoon) centres its 0.6 popups
# (ORGINDEX, SCRATCHPAD) on the 1512x950 built-in screen: 302,222 907x570. Without this a new
# window copies the front window's size, so a popup flashed large before nanowm shrank it.
# Tiled windows are moved off this frame right away. Cells are 9.5x21 pt at font-size 16, so
# 95x27 is 903x567; y is below the menu bar. Position is macOS-only.
window-position-x = 302
window-position-y = 190
window-width = 95
window-height = 27

# Lifecycle: quit app when last window closes (prevents lingering dock icons)
quit-after-last-window-closed = true

# macOS behavior (Kanata home-row mod compatibility)
macos-option-as-alt = true

# Cursor (fixed colors; adaptive cell-foreground is invisible when the cell fg
# equals the bg, e.g. nightfox Whitespace fg == CursorLine bg == #29394f)
cursor-style = block
cursor-style-blink = false
cursor-color = #cdcecf
cursor-text = cell-background
adjust-cursor-thickness = 3

# Colors (Exact custom TokyoNight palette from alacritty.nix)
background = #1a1b26
foreground = #cdcecf
selection-background = #2b3b51
selection-foreground = #cdcecf

palette = 0=#393b44
palette = 1=#c94f6d
palette = 2=#81b29a
palette = 3=#dbc074
palette = 4=#719cd6
palette = 5=#9d79d6
palette = 6=#63cdcf
palette = 7=#dfdfe0
palette = 8=#575860
palette = 9=#d16983
palette = 10=#8ebaa4
palette = 11=#e0c989
palette = 12=#86abdc
palette = 13=#baa1e2
palette = 14=#7ad5d6
palette = 15=#e4e4e5
palette = 16=#f4a261
palette = 17=#d67ad2

# Clipboard & Surface
copy-on-select = clipboard
confirm-close-surface = false
