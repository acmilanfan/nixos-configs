#!/usr/bin/env bash

STATE_FILE="${XDG_RUNTIME_DIR:-$HOME/.cache}/hypr-timer.json"
mkdir -p "$(dirname "$STATE_FILE")"

get_end_time() {
    [ ! -f "$STATE_FILE" ] && echo 0 && return
    jq -r '.end_time // 0' "$STATE_FILE"
}

is_running() {
    [ ! -f "$STATE_FILE" ] && echo false && return
    jq -r '.running // false' "$STATE_FILE"
}

start_timer() {
    duration=$(( ${1:-25} * 60 ))
    end_time=$(( $(date +%s) + duration ))
    echo "{\"running\": true, \"end_time\": $end_time, \"duration\": $duration}" > "$STATE_FILE"
}

stop_timer() {
    [ ! -f "$STATE_FILE" ] && return
    tmp=$(mktemp)
    jq '.running = false' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

reset_timer() {
    rm -f "$STATE_FILE"
}

get_output() {
    running=$(is_running)
    end_time=$(get_end_time)

    if [ "$running" != "true" ] || [ "$end_time" -eq 0 ]; then
        echo '{"text": "", "class": "stopped"}'
        return
    fi

    remaining=$(( end_time - $(date +%s) ))

    if [ "$remaining" -le 0 ]; then
        echo '{"text": "󰔟 00:00", "class": "finished", "tooltip": "Timer finished!"}'
        return
    fi

    mins=$(( remaining / 60 ))
    secs=$(( remaining % 60 ))
    printf '{"text": "󰔟 %02d:%02d", "class": "running", "tooltip": "Remaining: %02d:%02d"}\n' "$mins" "$secs" "$mins" "$secs"
}

prompt_timer() {
    local value
    command -v vicinae >/dev/null 2>&1 || return 1
    value=$(vicinae dmenu -p "Timer minutes:") || return 0
    [[ "$value" =~ ^[0-9]+$ ]] || return 0
    (( 10#$value > 0 )) || return 0
    start_timer "$((10#$value))"
}

notify_timer() {
    local out text tooltip
    out=$(get_output)
    text=$(jq -r '.text // ""' <<< "$out")
    if [ -z "$text" ]; then
        notify-send -t 2000 "Timer" "No timer running"
    else
        tooltip=$(jq -r '.tooltip // .text' <<< "$out")
        notify-send -t 3000 "Timer" "$tooltip"
    fi
}

case "$1" in
    start) start_timer "$2" ;;
    prompt) prompt_timer ;;
    notify) notify_timer ;;
    stop)  stop_timer ;;
    reset) reset_timer ;;
    output) get_output ;;
    *) get_output ;;
esac
