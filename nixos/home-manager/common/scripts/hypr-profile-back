#!/usr/bin/env bash

choice=$(printf "Vertical (stacked)\nHorizontal (wide)\nSingle screen top\nSingle screen top (tablet)\nDesk (external)" | rofi -dmenu -p "Display mode")

case "$choice" in
"Vertical (stacked)")
hyprctl eval "hl.monitor({output='eDP-1',mode='2880x1800@120',position='0x0',scale=1.6})"
hyprctl eval "hl.monitor({output='eDP-2',mode='2880x1800@120',position='0x1800',scale=1.6})" ;;
"Horizontal (wide)")
hyprctl eval "hl.monitor({output='eDP-1',mode='2880x1800@120',position='0x0',scale=1.6})"
hyprctl eval "hl.monitor({output='eDP-2',mode='2880x1800@120',position='2880x0',scale=1.6})" ;;
"Single screen top")
hyprctl eval "hl.monitor({output='eDP-1',mode='2880x1800@120',position='0x0',scale=1.6})"
hyprctl eval "hl.monitor({output='eDP-2',disabled=true})" ;;
"Single screen top (tablet)")
hyprctl eval "hl.monitor({output='eDP-1',mode='2880x1800@120',position='0x0',scale=1.8})"
hyprctl eval "hl.monitor({output='eDP-2',disabled=true})" ;;
"Desk (external)")
for m in DP-1 DP-2 DP-3; do hyprctl eval "hl.monitor({output='$m',mode='3840x2160@120',position='0x0',scale=2})"; done ;;
esac
