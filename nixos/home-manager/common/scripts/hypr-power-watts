#!/usr/bin/env bash
set -euo pipefail

BAT_PATH="${HYPR_BAT_PATH:-/sys/class/power_supply/BAT0}"
[ -d "$BAT_PATH" ] || BAT_PATH="/sys/class/power_supply/BAT1"
[ -d "$BAT_PATH" ] || { echo '{"text": "󱐋 --W", "class": "none"}'; exit 0; }

if [ -r "$BAT_PATH/power_now" ]; then
  micro=$(cat "$BAT_PATH/power_now")
elif [ -r "$BAT_PATH/current_now" ] && [ -r "$BAT_PATH/voltage_now" ]; then
  micro=$(( $(cat "$BAT_PATH/current_now") * $(cat "$BAT_PATH/voltage_now") / 1000000 ))
else
  echo '{"text": "󱐋 --W", "class": "none"}'
  exit 0
fi

watts=$(awk -v u="$micro" 'BEGIN { printf "%.1f", u / 1000000 }')
class=low
awk -v w="$watts" 'BEGIN { exit !(w > 30) }' && class=high
awk -v w="$watts" 'BEGIN { exit !(w > 15 && w <= 30) }' && class=medium
printf '{"text": "󱐋 %sW", "class": "%s", "tooltip": "Usage: %s Watts"}\n' "$watts" "$class" "$watts"
