#!/usr/bin/env bash
# Write a one-line .envrc (`use_tech`) into a project dir if it doesn't have one.
# Called by tmux-sessionizer so newly picked-up projects get their nix devshell
# applied automatically via direnv on first entry.
# Usage: tech-envrc [dir]

d="${1:-.}"

[ -f "$d/.envrc" ] && exit 0

# Never touch ~/configs (flake has no devshell)
case "$(cd "$d" 2>/dev/null && pwd -P)" in
  "$HOME/configs"|"$HOME/configs"/*) exit 0 ;;
esac

if [ -f "$d/go.mod" ] \
  || [ -f "$d/package.json" ] \
  || [ -f "$d/pom.xml" ] \
  || [ -f "$d/build.gradle" ] \
  || [ -f "$d/build.gradle.kts" ] \
  || [ -f "$d/pyproject.toml" ] \
  || [ -f "$d/requirements.txt" ] \
  || [ -f "$d/uv.lock" ] \
  || [ -f "$d/flake.nix" ]; then
  printf 'use_tech\n' > "$d/.envrc"
  # We just wrote it (one line, no repo content), so trust it explicitly:
  # direnv has no blanket whitelist; a cloned repo's own .envrc still needs
  # a manual `direnv allow`.
  command -v direnv >/dev/null && direnv allow "$d"
  echo "tech-envrc: created $d/.envrc"
fi
