#!/usr/bin/env bash

# Only run if Hyprland is active
if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    exit 0
fi

# The start-hyprland watchdog relaunches Hyprland after crashes with socket
# handover, so long-lived shells keep env pointing at dead instances.
# Resolve the live one if the inherited signature no longer exists.
SIG_DIR="/run/user/$(id -u)/hypr"
if [ ! -d "$SIG_DIR/$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    LIVE=$(ls -t "$SIG_DIR" 2>/dev/null | head -1)
    [ -n "$LIVE" ] && export HYPRLAND_INSTANCE_SIGNATURE="$LIVE"
fi

echo "🔄 Reloading desktop components..."

# 1. Restart the bar. The Quickshell service is enabled only on the Yoga
# Book; restarting it reloads the new QML without bringing Waybar back.
if systemctl --user is-enabled --quiet quickshell-shell.service 2>/dev/null; then
    # Activation can restart the unit at the same time, which cancels this job.
    # Verify afterwards and start it only if neither job left it running.
    systemctl --user restart quickshell-shell.service >/dev/null 2>&1 || true
    sleep 0.5
    systemctl --user is-active --quiet quickshell-shell.service ||
        systemctl --user start quickshell-shell.service >/dev/null 2>&1 || true
else
    # pkill -USR2 sometimes kills waybar if there are config issues, so a full
    # restart is more reliable for nixos-rebuild.
    hypr-waybar-toggle restart
fi

# 2. Reload SwayNC
if command -v swaync-client >/dev/null; then
    swaync-client -R 2>/dev/null || true
    swaync-client -rs 2>/dev/null || true
fi

# 3. Reload Hyprland configuration
hyprctl reload 2>/dev/null || true

# 4. Restore the saved display profile (hyprctl reload resets monitor layout)
sleep 1
hypr-profile restore 2>/dev/null || true

# 5. Apply the current hyprsunset temperature profile (tint only).
sleep 0.5
systemctl --user restart hyprsunset 2>/dev/null || true

notify-send -u low -t 2000 "Desktop" "Components reloaded"
