#!/usr/bin/env bash

get_agents() {
  local rows
  rows=$(ai-agent-list)

  if [ -z "$rows" ]; then
    echo '{"text": "", "class": "none"}'
    return
  fi

  local MAX_PRIO=0 STATUS="idle" C_COUNT=0 G_COUNT=0 A_COUNT=0

  while IFS='|' read -r pane_id state type project cwd; do
    [ -z "$pane_id" ] && continue
    [[ "$type" == "Claude" ]] && ((C_COUNT++))
    [[ "$type" == "Gemini" ]] && ((G_COUNT++))
    [[ "$type" == "Antigravity" ]] && ((A_COUNT++))

    case "$state" in
      needs-input) [[ $MAX_PRIO -lt 3 ]] && MAX_PRIO=3 && STATUS="needs-input" ;;
      running)     [[ $MAX_PRIO -lt 2 ]] && MAX_PRIO=2 && STATUS="running" ;;
      done)        [[ $MAX_PRIO -lt 1 ]] && MAX_PRIO=1 && STATUS="recent" ;;
    esac
  done <<< "$rows"

  if [ "$C_COUNT" -eq 0 ] && [ "$G_COUNT" -eq 0 ] && [ "$A_COUNT" -eq 0 ]; then
    echo '{"text": "", "class": "none"}'
    return
  fi

  LABEL=""
  [ "$C_COUNT" -gt 0 ] && LABEL="C:${C_COUNT}"
  [ "$G_COUNT" -gt 0 ] && LABEL="${LABEL:+$LABEL }G:${G_COUNT}"
  [ "$A_COUNT" -gt 0 ] && LABEL="${LABEL:+$LABEL }A:${A_COUNT}"

  ICON="󰧑"
  [[ "$STATUS" == "needs-input" ]] && ICON="󰀦"
  [[ "$STATUS" == "recent" ]] && ICON="󰄬"
  [[ "$STATUS" == "idle" ]] && ICON="󰧒"

  echo "{\"text\": \"$ICON $LABEL\", \"class\": \"$STATUS\"}"
}

focus_agent() {
  pane_id="$1"
  info=$(tmux list-panes -a -F '#{pane_id} #{session_name} #{window_index}' -f "#{m:#{pane_id},$pane_id}" 2>/dev/null)
  read -r p_id session win_idx <<< "$info"
  if [ -n "$p_id" ]; then
    tmux switch-client -t "$session"
    tmux select-window -t "$session:$win_idx"
    tmux select-pane -t "$p_id"
    client_pid=$(tmux list-clients -t "$session" -F '#{client_pid}' 2>/dev/null | head -1)
    if [ -n "$client_pid" ]; then
      hyprctl dispatch "hl.dsp.focus({window = 'pid:$client_pid'})"
    fi
  fi
}

show_menu() {
  local rows choice pane_id
  rows=$(ai-agent-list)

  if [ -z "$rows" ]; then
    echo "No AI agents running" | fuzzel -d --width 50 >/dev/null
    return
  fi

  choice=$(printf '%s\n' "$rows" | awk -F'|' '{printf "%s  %s  %s: %s\n", $1, $2, $3, $4}' | fuzzel -d --width 50)
  [ -z "$choice" ] && return
  pane_id=$(echo "$choice" | awk '{print $1}')
  focus_agent "$pane_id"
}

case "$1" in
  --focus) focus_agent "$2" ;;
  --menu) show_menu ;;
  *) get_agents ;;
esac
