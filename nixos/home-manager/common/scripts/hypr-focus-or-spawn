#!/usr/bin/env bash
set -euo pipefail

# Usage: hypr-focus-or-spawn <class> <title_regex> <command...>
class=$1
title=$2
shift 2

# Pass inputs to jq as data; never splice them into the program.
clients=$(hyprctl -j clients) || exit 1
address=$(jq -r --arg class "$class" --arg title "$title" '
  [ .[] | select(.mapped == true and .class == $class
      and ((.title // "") | test($title; "i"))) ]
  | first | .address // empty' <<< "$clients") || exit 1

if [[ -n "$address" ]]; then
  # Special workspaces have negative ids; their names are the stable selector.
  workspace=$(hyprctl -j activeworkspace | jq -r '.name // (.id | tostring)') || exit 1
  selector=$(jq -rn --arg w "$workspace" '$w | @json') || exit 1
  hyprctl dispatch "hl.dsp.focus({window = 'address:$address'})"
  hyprctl dispatch "hl.dsp.window.move({workspace = $selector})"
  hyprctl dispatch "hl.dsp.window.float({action = 'enable'})"
  hyprctl dispatch "hl.dsp.window.center()"
else
  setsid sh -c "$*" >/dev/null 2>&1 &
fi
