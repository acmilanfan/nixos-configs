#!/bin/bash

# Hyprland 0.55.4: exact positioning/resizing not available via Lua API.
# Use fullscreen + float + noborder as equivalent.

hyprctl dispatch "hl.dsp.window.fullscreen_state({internal = 0, client = 0})"
hyprctl dispatch "hl.dsp.window.float()"
hyprctl eval 'hl.dsp.window.set_prop({prop = "noborder", value = 1})'
hyprctl dispatch "hl.dsp.window.fullscreen_state({internal = 1, client = 1})"
