#!/usr/bin/env bash
set -euo pipefail

# Usage: hypr-quickshell-pilot start|stop|toggle|status
waybar_config="$HOME/.config/waybar/config-hypr-bottom"
waybar_style="$HOME/.config/waybar/style-hypr.css"
waybar_pattern='waybar -c .*config-hypr-bottom'
quickshell_pattern='quickshell -c pilot'

quickshell_running() { pgrep -f "$quickshell_pattern" >/dev/null; }
waybar_running() { pgrep -f "$waybar_pattern" >/dev/null; }

stop_waybar() { pkill -f "$waybar_pattern" 2>/dev/null || true; }
start_waybar() {
  setsid waybar -c "$waybar_config" -s "$waybar_style" >/dev/null 2>&1 &
}
stop_quickshell() { pkill -f "$quickshell_pattern" 2>/dev/null || true; }
start_quickshell() {
  quickshell_running && return 0
  setsid quickshell -c pilot >/dev/null 2>&1 &
}

case "${1:-status}" in
  start)
    stop_waybar
    start_quickshell
    ;;
  stop)
    stop_quickshell
    start_waybar
    ;;
  toggle)
    if quickshell_running; then
      stop_quickshell
      start_waybar
    else
      stop_waybar
      start_quickshell
    fi
    ;;
  status)
    if quickshell_running; then
      echo "quickshell pilot: running"
    else
      echo "quickshell pilot: stopped"
    fi
    ;;
  *)
    echo "usage: ${0##*/} start|stop|toggle|status" >&2
    exit 2
    ;;
esac
