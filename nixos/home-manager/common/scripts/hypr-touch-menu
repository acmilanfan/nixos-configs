#!/usr/bin/env bash

# Main menu items
choice=$(echo -e "🚀 Apps\n💻 Profiles\n🔄 Auto-rotate: $(systemctl --user is-active hypr-iio-rotate.service >/dev/null && echo "ON" || echo "OFF")\n📊 Waybar Toggle\n⌨️ Keyboard\n📶 Network\n Bluetooth\n💡 Brightness\n🔊 Volume\n🔒 Power" | \
    vicinae dmenu -p "Touch Menu: ")

case "$choice" in
    "🚀 Apps")
        nwg-drawer
        ;;
    "💻 Profiles")
        hypr-profile
        ;;
    "🔄 Auto-rotate"*)
        hypr-iio-toggle
        ;;
    "📊 Waybar Toggle")
        hypr-waybar-toggle
        ;;
    "⌨️ Keyboard")
        hypr-toggle-kb
        ;;
    "📶 Network")
        iwmenu -l custom --launcher-command 'vicinae dmenu -p "{hint}"'
        ;;
    " Bluetooth")
        bzmenu -l custom --launcher-command 'vicinae dmenu -p "{hint}"'
        ;;
    "💡 Brightness")
        val=$(echo -e "100%\n80%\n60%\n40%\n20%\n5%" | vicinae dmenu -p "Brightness: ")
        if [[ -n "$val" ]]; then
            # Remove % for set-sync-brightness
            clean_val="${val%%%}"
            if command -v set-sync-brightness >/dev/null; then
                set-sync-brightness "$clean_val"
            else
                brightnessctl set "$val"
            fi
        fi
        ;;
    "🔊 Volume")
        val=$(echo -e "100%\n80%\n60%\n40%\n20%\n0%" | vicinae dmenu -p "Volume: ")
        if [[ -n "$val" ]]; then
             # Remove % for change-volume
             clean_val="${val%%%}"
             if command -v change-volume >/dev/null; then
                change-volume "$clean_val"
            else
                pamixer --set-volume "$clean_val"
            fi
        fi
        ;;
    "🔒 Power")
        wlogout
        ;;
esac
