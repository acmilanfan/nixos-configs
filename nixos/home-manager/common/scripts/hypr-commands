#!/bin/bash

# Commands Menu (Searchable Actions)
# Labels map to fixed commands in the case below (no eval of the choice).
# Kanata scripts live in ~/.config/kanata (yogabook only), not on PATH.

KANATA_DIR="$HOME/.config/kanata"

LABELS=(
  "Reload Hyprland Config"
  "Toggle Monocle/Tile"
  "Timer: Start 25m"
  "Timer: Start 5m"
  "Timer: Stop"
  "Timer: Reset"
  "Kanata: Home Row"
  "Kanata: Disabled"
  "Reload Kanata"
  "AI Agents Menu"
  "Switch Window"
  "Lock Screen"
  "Caffeinate: Toggle"
  "Battery Saver: Toggle"
  "Animations: Toggle"
)

# Show menu (newline separated for vicinae dmenu) and get choice
CHOICE=$(printf "%s\n" "${LABELS[@]}" | vicinae dmenu -W 600 -p "Search Commands...")

case "$CHOICE" in
  "Reload Hyprland Config") hyprctl reload ;;
  "Toggle Monocle/Tile") hypr-cycle-layout ;;
  "Timer: Start 25m") hypr-timer start 25 ;;
  "Timer: Start 5m") hypr-timer start 5 ;;
  "Timer: Stop") hypr-timer stop ;;
  "Timer: Reset") hypr-timer reset ;;
  "Kanata: Home Row") "$KANATA_DIR/switch-kanata.sh" homerow ;;
  "Kanata: Disabled") "$KANATA_DIR/switch-kanata.sh" disabled ;;
  "Reload Kanata") "$KANATA_DIR/reload-kanata.sh" restart ;;
  "AI Agents Menu") hypr-ai-agents --menu ;;
  "Switch Window") hypr-focus-window ;;
  "Lock Screen") hyprlock ;;
  "Caffeinate: Toggle") hypr-idle-inhibit toggle ;;
  "Battery Saver: Toggle") hypr-powersave-mode toggle ;;
  "Animations: Toggle") hypr-animations-toggle ;;
esac
