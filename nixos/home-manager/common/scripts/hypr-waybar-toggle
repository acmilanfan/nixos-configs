#!/usr/bin/env bash

# Resolve the live Hyprland instance if the inherited signature is stale or
# missing (start-hyprland relaunches after crashes keep old shells pointing at
# dead instances); waybar's hyprland modules need the current signature.
SIG_DIR="${HYPR_SIG_DIR:-/run/user/$(id -u)/hypr}"
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || [ ! -d "$SIG_DIR/$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    LIVE=$(ls -t "$SIG_DIR" 2>/dev/null | head -1)
    [ -n "$LIVE" ] && export HYPRLAND_INSTANCE_SIGNATURE="$LIVE"
fi

# Serialize starts: ExecStopPost and a manual `on` can otherwise race and kill
# each other's freshly started bars.
if command -v flock >/dev/null 2>&1; then
    LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/hypr-waybar-toggle.lock"
    exec 9>"$LOCK_FILE" 2>/dev/null && flock -w 10 9 2>/dev/null || true
fi

# Spawn through Hyprland so the process lands in the session scope, not in the
# caller's service cgroup (systemd would kill it when that unit stops). Fall
# back to a direct spawn if Hyprland is unavailable; close the lock fd so a
# fallback bar does not hold it.
spawn_detached() {
    local lua
    lua="hl.exec_cmd([[$(printf '%q ' "$@")]])"
    if command -v hyprctl >/dev/null 2>&1 &&
        hyprctl eval "$lua" >/dev/null 2>&1; then
        return 0
    fi
    nohup "$@" 9>&- >/dev/null 2>&1 &
}

# Function to kill waybar instances based on our specific configs
kill_waybar() {
    pkill -f "waybar -c .*config-hypr" 2>/dev/null
    # Also kill any generic waybar just in case
    killall .waybar-wrapped 2>/dev/null
    killall waybar 2>/dev/null
    sleep 0.2
}

# Function to start waybar
start_waybar() {
    pkill -f '^([^ ]*/)?quickshell -c shell' 2>/dev/null || true
    kill_waybar
    spawn_detached waybar -c ~/.config/waybar/config-hypr-top -s ~/.config/waybar/style-hypr.css
    spawn_detached waybar -c ~/.config/waybar/config-hypr-bottom -s ~/.config/waybar/style-hypr.css
    spawn_detached waybar -c ~/.config/waybar/config-hypr-external -s ~/.config/waybar/style-hypr.css
}

case "$1" in
    on)
        start_waybar
        ;;
    off)
        kill_waybar
        ;;
    restart)
        start_waybar
        ;;
    *)
        # Toggle behavior
        if pgrep -f "waybar -c .*config-hypr" >/dev/null; then
            kill_waybar
        else
            start_waybar
        fi
        ;;
esac
