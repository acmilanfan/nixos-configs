#!/usr/bin/env bash

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(find ~/IdeaProjects ~/Projects ~/ ~/configs ~/Work/IdeaProjects -mindepth 1 -maxdepth 1 -type d | fzf)
fi

if [[ -z $selected ]]; then
  exit 0
fi

# Ensure the project has a .envrc so direnv picks the right nix devshell
# (only under project roots - avoid e.g. ~/configs which has a flake.nix
# but no devshell)
case "$selected" in
  "$HOME/Projects"|"$HOME/Projects"/*|"$HOME/IdeaProjects"|"$HOME/IdeaProjects"/*|"$HOME/Work/IdeaProjects"|"$HOME/Work/IdeaProjects"/*)
    command -v tech-envrc >/dev/null && tech-envrc "$selected"
    ;;
esac

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -s $selected_name -c $selected
  exit 0
fi

if ! tmux has-session -t=$selected_name 2> /dev/null; then
  tmux new-session -ds $selected_name -c $selected
fi

tmux switch-client -t $selected_name
