#!/usr/bin/env bash
# Remove a linked git worktree: fuzzy-picked, or the one named by the argument
# (its path, directory name or branch). Never the main worktree.
#
#   worktree-remove [-f|--force] [--kill-session|--keep-session] [worktree]
#
# A worktree with uncommitted or untracked changes, or one git refuses to
# remove (e.g. locked), is removed only after confirming, or with --force.
# The tmux session named after it is killed after confirming, or with
# --kill-session. Without a terminal every question is answered no.

force_opt="" session_opt="" query=""
for arg in "$@"; do
  case "$arg" in
    -f|--force) force_opt=1 ;;
    --kill-session) session_opt="kill" ;;
    --keep-session) session_opt="keep" ;;
    -*) echo "worktree-remove: unknown option $arg" >&2; exit 2 ;;
    *) query="$arg" ;;
  esac
done

# Paths of the worktrees whose path, directory name or branch is $1, or
# whose path is $2 (the resolved $1, as git prints symlinked paths resolved).
match_worktrees() {
  local want="$1" abs="$2"
  git worktree list --porcelain 2>/dev/null |
    W="$want" A="$abs" awk '
      function check() {
        n = split(p, parts, "/")
        if (p != "" && (p == ENVIRON["W"] || p == ENVIRON["A"] || parts[n] == ENVIRON["W"] || b == ENVIRON["W"]))
          print p
        p = b = ""
      }
      /^worktree / { p = substr($0, 10) }
      /^branch / { b = substr($0, 8); sub(/^refs\/heads\//, "", b) }
      /^$/ { check() }
      END { check() }'
}

# a path argument may live in another repository than the current dir
abs=""
if [[ -n "$query" && -d "$query" ]]; then
  abs=$(cd "$query" && pwd -P) && cd "$abs" || exit 1
fi

# Collect all worktrees except the primary one (the whole rest of the line:
# paths may contain spaces)
mapfile -t all < <(git worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
if [[ ${#all[@]} -lt 2 ]]; then
  echo "No linked worktrees to remove." >&2
  [[ -z "$query" ]] || exit 1
  exit 0
fi

# The first entry is always the main worktree — skip it
worktrees=("${all[@]:1}")

if [[ -n "$query" ]]; then
  mapfile -t matches < <(match_worktrees "$query" "$abs")
  if [[ ${#matches[@]} -ne 1 ]]; then
    echo "worktree-remove: ${#matches[@]} worktrees match '$query'" >&2
    exit 1
  fi
  selected="${matches[0]}"
  if [[ "$selected" == "${all[0]}" ]]; then
    echo "worktree-remove: $selected is the main worktree" >&2
    exit 1
  fi
else
  selected=$(printf '%s\n' "${worktrees[@]}" \
    | fzf --prompt="Remove worktree > " \
          --preview="git -C {} log --oneline --color=always -10 2>/dev/null; echo; ls {}" \
          --height=50%)
fi

[[ -z "$selected" ]] && exit 0

# yes/no question; --force or --kill-session answer it up front
confirm() {
  local answer
  read -r -p "$1 [y/N] " answer
  [[ "$answer" == [yY] ]]
}

# Check for uncommitted changes. `git status --porcelain` covers staged,
# unstaged, and untracked changes (ignored files excluded) — the same
# conditions under which `git worktree remove` refuses without --force.
if [[ -n "$(git -C "$selected" status --porcelain 2>/dev/null)" ]]; then
  if [[ -z "$force_opt" ]] && ! confirm "Worktree has uncommitted or untracked changes. Remove anyway?"; then
    echo "Kept: $selected (uncommitted or untracked changes; --force removes it)" >&2
    exit 0
  fi
  force="--force"
fi

# Kill leftover nvim processes whose cwd is this worktree
# (prevents orphaned --embed nvim from leaking after tmux kill-session)
for pid in $(pgrep nvim 2>/dev/null); do
  # -a (AND) + -d cwd + -F n prints just the cwd record; a plain
  # `lsof -p "$pid" -F n` lists every open file, so it never equals a path.
  cwd=$(lsof -a -p "$pid" -d cwd -F n 2>/dev/null | sed -n 's/^n//p')
  if [[ "$cwd" == "$selected" ]]; then
    kill "$pid" 2>/dev/null
    echo "Killed orphaned nvim (PID $pid) in $selected"
  fi
done

# Remove the worktree, honouring the dirty flag set above.
try_remove() {
  if [[ -n "${force:-}" ]]; then
    git worktree remove --force "$selected"
  else
    git worktree remove "$selected"
  fi
}

# "locked" line of the selected worktree's porcelain record, if any
lock_line() {
  git worktree list --porcelain 2>/dev/null |
    P="$selected" awk '$0 == "worktree " ENVIRON["P"] { f = 1; next } /^$/ { f = 0 } f && /^locked/ { print; exit }'
}

# git can still refuse (locked worktree, or dirtiness git sees and we do not),
# so retry once with --force on request and never report a removal that failed.
# A locked worktree needs --force twice.
removed=0
if try_remove; then
  removed=1
else
  force_args=(--force)
  lock="$(lock_line)"
  if [[ -n "$lock" ]]; then
    reason="${lock#locked}"
    echo "Worktree is locked${reason:+:${reason}}." >&2
    force_args=(--force --force)
  fi
  if { [[ -n "$force_opt" ]] || confirm "git could not remove the worktree. Force removal?"; } &&
    git worktree remove "${force_args[@]}" "$selected"; then
    removed=1
  fi
fi

if ((removed == 0)); then
  echo "Failed to remove: $selected" >&2
  exit 1
fi

echo "Removed: $selected"

# Kill the associated tmux session if it exists
session_name=$(basename "$selected" | tr '.' '_')
if tmux has-session -t="$session_name" 2>/dev/null; then
  case "$session_opt" in
    kill) tmux kill-session -t "$session_name" ;;
    keep) ;;
    *) if confirm "Kill tmux session '$session_name'?"; then tmux kill-session -t "$session_name"; fi ;;
  esac
fi
