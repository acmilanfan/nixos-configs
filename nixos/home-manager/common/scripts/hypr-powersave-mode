#!/usr/bin/env bash

# The Lua config parser rejects `hyprctl keyword`, so settings go through
# `hyprctl eval` (same values as _toggle_powersave in hyprland.lua). getoption
# prints "bool: true|false" there; accept 1/0 too.
CURRENT_STATE=$(hyprctl getoption animations:enabled | awk 'NR==1{print $2}')
case "$CURRENT_STATE" in
    1|true) ANIMATIONS_ON=1 ;;
    *) ANIMATIONS_ON=0 ;;
esac

MODE="$1"
if [ "$MODE" = toggle ]; then
    if [ "$ANIMATIONS_ON" = 1 ]; then MODE=on; else MODE=off; fi
fi

case "$MODE" in
    on)
        if [ "$ANIMATIONS_ON" = 1 ]; then
            hyprctl eval "hl.config({
                animations = { enabled = false },
                decoration = {
                    shadow = { enabled = false },
                    blur = { enabled = false },
                    fullscreen_opacity = 1,
                    rounding = 0,
                },
                general = { gaps_in = 0, gaps_out = 0, border_size = 1 },
            })"
            hyprctl notify 1 5000 "rgb(40a02b)" "Powersave mode [ON]"
        fi
        ;;
    off)
        if [ "$ANIMATIONS_ON" = 0 ]; then
            hyprctl reload
            hyprctl notify 1 5000 "rgb(d20f39)" "Powersave mode [OFF]"
        fi
        ;;
    *)
        echo "Usage: $0 {on|off|toggle}"
        exit 1
        ;;
esac

exit 0
