#!/usr/bin/env bash
# Benchmark Qwen 3.8 local inference servers (mtplx / oMLX) for prefill (TTFT),
# eval throughput (tok/s), and total memory. See the sibling .py for details.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="/etc/profiles/per-user/gentooway/bin:$PATH"
exec uvx --from openai python "$SCRIPT_DIR/qwen38-bench.py" "$@"
