#!/usr/bin/env bash

# The Lua config parser rejects `hyprctl keyword`; use `hyprctl eval`
# (same as _toggle_animations in hyprland.lua). getoption prints
# "bool: true|false" there; accept 1 too.
ANIMATIONS=$(hyprctl getoption animations:enabled | awk 'NR==1{print $2}')
if [ "$ANIMATIONS" = 1 ] || [ "$ANIMATIONS" = true ]; then
    hyprctl eval "hl.config({ animations = { enabled = false } })"
    hyprctl notify 1 5000 "rgb(40a02b)" "Animations OFF"
    exit 0
else
    hyprctl notify 1 5000 "rgb(d20f39)" "Animations ON"
    hyprctl reload
    exit 0
fi
