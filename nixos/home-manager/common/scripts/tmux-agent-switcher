#!/bin/bash

# ═══════════════════════════════════════════════════════════════
# tmux-agent-switcher — fzf --tmux popup listing AI agent panes.
# Data comes from the shared ai-agent-list script; selecting an entry
# focuses the pane (Hammerspoon/NanoWM on macOS, tmux+hyprctl on Linux).
# ═══════════════════════════════════════════════════════════════

ROWS=$(ai-agent-list)
[ -z "$ROWS" ] && exit 0

format_row() {
  local pane_id status type project cwd
  IFS='|' read -r pane_id status type project cwd <<< "$1"
  local word color glyph
  case "$status" in
    running)     word="working"; color="\033[33m"; glyph="●" ;;      # yellow
    needs-input) word="needs input"; color="\033[31m"; glyph="⚠" ;;   # red
    done)        word="done"; color="\033[35m"; glyph="◉" ;;          # purple
    idle)        word="idle"; color="\033[90m"; glyph="○" ;;          # dim gray
    *)           word="$status"; color=""; glyph="?" ;;
  esac
  printf '%s|%b%s %s\033[0m|%s|%s|%s\n' "$pane_id" "$color" "$glyph" "$word" "$type" "$project" "$cwd"
}

SELECTED=$(
  { while IFS= read -r row; do format_row "$row"; done <<< "$ROWS"; } \
  | fzf --tmux 70%,50% --border --ansi --header="go to agent" \
        --delimiter='|' --with-nth='{2}  {3}  {4}'
)

[ -z "$SELECTED" ] && exit 0

PANE_ID=$(echo "$SELECTED" | cut -d'|' -f1)
case "$PANE_ID" in
  %[0-9]*) ;;
  *) exit 0 ;;
esac

# Focus the selected pane. macOS delegates to Hammerspoon/NanoWM; Linux uses
# tmux client/window/pane switching (same logic as hypr-ai-agents focus_agent).
case "$(uname -s)" in
  Darwin)
    /opt/homebrew/bin/hs -c "require('nanowm.agents').focusAgent('$PANE_ID')" 2>/dev/null
    ;;
  Linux)
    info=$(tmux list-panes -a -F '#{pane_id} #{session_name} #{window_index}' -f "#{m:#{pane_id},$PANE_ID}" 2>/dev/null)
    read -r p_id session win_idx <<< "$info"
    if [ -n "$p_id" ]; then
      tmux switch-client -t "$session"
      tmux select-window -t "$session:$win_idx"
      tmux select-pane -t "$p_id"
      client_pid=$(tmux list-clients -t "$session" -F '#{client_pid}' 2>/dev/null | head -1)
      if [ -n "$client_pid" ] && command -v hyprctl >/dev/null 2>&1; then
        hyprctl dispatch "hl.dsp.focus({window = 'pid:$client_pid'})" >/dev/null 2>&1
      fi
    fi
    ;;
esac
