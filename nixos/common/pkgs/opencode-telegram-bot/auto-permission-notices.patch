@@ -1,3 +1,5 @@
 import { t } from "../../i18n/index.js";
+import { opencodeClient } from "../../opencode/client.js";
+import { logger } from "../../utils/logger.js";
 import type { BackgroundSessionNotification } from "../../app/managers/background-session-manager.js";
 import { buildBackgroundSessionOpenKeyboard } from "../menus/session-selection-menu.js";
@@ -35,6 +37,53 @@
 export function createBackgroundNoticeDelivery(
   policy: Pick<SessionTargetPolicy, "getDestination">,
   delivery: TelegramEventDelivery,
+  directory: string,
+  isActive: () => boolean = () => true,
 ): (notification: BackgroundSessionNotification) => Promise<void> {
   return async (notification) => {
+    if (!isActive() || !policy.getDestination(notification.sessionId)) {
+      return;
+    }
+
+    if (notification.kind === "permission_asked") {
+      // Another client may auto-approve the request as soon as it is emitted.
+      // Check server state after a grace period, even if a reply event was missed.
+      await new Promise<void>((resolve) => setTimeout(resolve, 1500));
+      if (!isActive()) {
+        return;
+      }
+      let timeout: ReturnType<typeof setTimeout> | undefined;
+      try {
+        const { data, error } = await Promise.race([
+          opencodeClient.permission.list({ directory }),
+          new Promise<never>((_resolve, reject) => {
+            timeout = setTimeout(
+              () => reject(new Error("Pending permission lookup timed out")),
+              5000,
+            );
+          }),
+        ]);
+        if (error || !data) {
+          throw error ?? new Error("Pending permissions unavailable");
+        }
+        if (
+          !data.some(
+            (request) =>
+              request.id === notification.requestId && request.sessionID === notification.sessionId,
+          )
+        ) {
+          return;
+        }
+      } catch (error) {
+        // Do not hide a potentially blocked session when the lookup fails.
+        logger.warn("[BackgroundNotice] Failed to check pending permission:", error);
+      } finally {
+        clearTimeout(timeout);
+      }
+    }
+
+    if (!isActive()) {
+      return;
+    }
+
     const destination = policy.getDestination(notification.sessionId);
