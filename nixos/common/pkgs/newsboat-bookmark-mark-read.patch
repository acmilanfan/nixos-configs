+void ItemListFormAction::bookmark_succeeded(const std::string& url)
+{
+	const unsigned int itempos = list.get_position();
+	if (itempos >= visible_items.size()) {
+		return;
+	}
+	const auto item = visible_items[itempos].first;
+	if (item->link() != url) {
+		return;
+	}
+	try {
+		const bool was_unread = item->unread();
+		item->set_unread(false);
+		if (was_unread) {
+			v.get_ctrl().mark_article_read(item->guid(), true);
+		}
+		invalidate_list();
+	} catch (const DbException& e) {
+		v.get_statusline().show_error(strprintf::fmt(
+				_("Bookmark saved, but could not mark article read: %s"), e.what()));
+	}
 }
 
